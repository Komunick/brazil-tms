# Copy to apps/web/.env.local and fill in. NEVER commit the real .env.local.
# The SERVICE ROLE key must NOT have a NEXT_PUBLIC_ prefix — it is server-only (FR-023, STACK §5.2).

# Browser-safe (auth only — cannot reach Postgres; PostgREST is not exposed and RLS is deferred).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-publishable-key

# SERVER ONLY — used exclusively by apps/web/lib/supabase/admin.ts (auth.admin.* operations).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret-key

# SERVER ONLY — direct Postgres connection for Drizzle (the BFF data path; not PostgREST).
DATABASE_URL=postgres://postgres:postgres-super-secret-change-me@localhost:5432/postgres

# First-Admin seed (used by packages/db/seed/001-admin.ts; never commit real values).
SEED_ADMIN_EMAIL=admin@braziltransports.com.br
SEED_ADMIN_PASSWORD=replace-with-strong-temp-password

# Feature 008 — documents + billing-export Storage buckets, upload size cap, doc-checks cron.
DOCUMENTS_BUCKET=documents
EXPORTS_BUCKET=billing-exports
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_CHECKS_CRON=*/5 * * * *

# Robô do portal (infra/portal-robot). Sem o token a rota /api/imports/portal-feed fica desligada.
# Gerar: openssl rand -base64 48 — mínimo 32 caracteres.
PORTAL_FEED_TOKEN=
# Usuário de serviço em nome de quem o robô escreve eventos e auditoria.
PORTAL_FEED_ACTOR_EMAIL=

# Push do Agency Router da SPX (rota /api/imports/spx-feed). O segredo NÃO é nosso: a Shopee o
# cadastra para a nossa agência e assina cada evento com ele (HS256). Sem a variável a rota
# responde 503 e não grava nada.
SPX_ROUTER_SECRET=

# ── Integra 14.2, a API da gerenciadora Logae (026) ────────────────────────────────────────────
#
# Lidas SÓ NO WORKER. O login é de produção e dá escrita no sistema de um fornecedor: nunca em
# NEXT_PUBLIC_*, nunca em resposta de rota.
#
# NÃO EXISTE HOMOLOGAÇÃO para nós — medido em 2026-08-25, `Ambiente: "Homologacao"` responde
# `CodErro 100 — USUARIO INVALIDO`. Toda escrita acontece contra o sistema real, e a gerenciadora
# COBRA por solicitação. É por isso que as duas variáveis abaixo existem.
INTEGRA_LOGIN=
INTEGRA_SENHA=

# O interruptor. Ausente ou diferente de `true`, o job roda inteiro, grava em `trip_pre_sm` o corpo
# que TERIA mandado, e não chama a gerenciadora. É assim que se confere a feature sem criar nada.
INTEGRA_PRE_SM_ATIVO=false

# Teto de Pré-SM criadas automaticamente por dia. Começa em ZERO de propósito: enquanto ninguém
# confia no comportamento, cada criação é um ato deliberado. Sobe conforme a confiança.
INTEGRA_PRE_SM_TETO_DIARIO=0
