# Copy to infra/supabase/.env and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_PASSWORD=postgres-super-secret-change-me
POSTGRES_DB=postgres

# --- Public URLs ---
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

# --- JWT / keys ---
# JWT_SECRET signs the GoTrue tokens. ANON_KEY (publishable) and SERVICE_ROLE_KEY (secret) are
# JWTs signed with JWT_SECRET. Generate per the self-hosted Supabase docs; keep SERVICE_ROLE_KEY
# server-only (it must NOT appear in any NEXT_PUBLIC_* var).
JWT_SECRET=your-32-char-min-jwt-secret-change-me
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt

# --- Session policy (FR-003a) [VERIFY AT SETUP] ---
# GOTRUE_SESSIONS_INACTIVITY_TIMEOUT / GOTRUE_SESSIONS_TIMEBOX are set in docker-compose.yml.
# If the idle timeout is not honored on the pinned GoTrue image, wire the app-layer
# last_active_at fallback in apps/web/lib/auth/session.ts (research §4; task T061).

# --- SMTP (invite + forgot-password) [VERIFY AT SETUP] ---
# Without SMTP, inviteUserByEmail and forgot-password fail; the temp-password path still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@braziltransports.com.br
SMTP_SENDER_NAME=Brazil Transports TMS
