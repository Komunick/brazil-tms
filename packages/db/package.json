{
  "name": "@brazil-tms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
